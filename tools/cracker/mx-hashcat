#!/bin/bash
# ==============================================
# Mx Hashcat - Cracker GPU ultrarrápido
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx Hashcat - Cracker GPU            ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

if ! command -v hashcat &> /dev/null; then
    echo -e "${RED}[!] Hashcat no instalado${NC}"
    echo -e "${YELLOW}[!] Instalando...${NC}"
    sudo apt install -y hashcat
fi

if [ $# -lt 2 ]; then
    echo -e "${YELLOW}[!] Uso: mx-hashcat <hashfile> <tipo_hash>${NC}"
    echo -e "${YELLOW}[!] Tipos de hash comunes:${NC}"
    echo "  0  - MD5"
    echo "  100 - SHA1"
    echo "  1400 - SHA256"
    echo "  1700 - SHA512"
    echo "  1000 - NTLM"
    exit 1
fi

echo -e "${GREEN}[+] Iniciando crackeo con GPU...${NC}"
hashcat -m "$2" "$1" /usr/share/wordlists/rockyou.txt
