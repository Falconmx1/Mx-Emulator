#!/bin/bash
# ==============================================
# Mx XSS - Escáner de XSS
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx XSS - Escáner de XSS             ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

if [ -z "$1" ]; then
    echo -e "${YELLOW}[!] Uso: mx-xss <URL> [param]${NC}"
    echo -e "${YELLOW}[!] Ejemplo: mx-xss http://target.com/page.php?q=test${NC}"
    exit 1
fi

echo -e "${GREEN}[+] Escaneando XSS en $1...${NC}"

# Payloads básicos de XSS
PAYLOADS=(
    "<script>alert('XSS')</script>"
    "\"><script>alert('XSS')</script>"
    "'><script>alert('XSS')</script>"
    "<img src=x onerror=alert('XSS')>"
    "javascript:alert('XSS')"
)

for payload in "${PAYLOADS[@]}"; do
    echo -e "${YELLOW}[*] Probando: $payload${NC}"
    if command -v curl &> /dev/null; then
        RESPONSE=$(curl -s -A "Mozilla/5.0" "$1" | grep -i "$payload")
        if [ ! -z "$RESPONSE" ]; then
            echo -e "${RED}[!] POSIBLE XSS ENCONTRADO!${NC}"
            echo -e "${RED}[!] Payload: $payload${NC}"
        fi
    fi
done

echo -e "${GREEN}[+] Escaneo completado${NC}"
