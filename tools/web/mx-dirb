#!/bin/bash
# ==============================================
# Mx Dirb - Escáner de directorios
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx Dirb - Escáner de Directorios    ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

if ! command -v dirb &> /dev/null; then
    echo -e "${RED}[!] Dirb no instalado${NC}"
    echo -e "${YELLOW}[!] Instalando...${NC}"
    sudo apt install -y dirb
fi

if [ -z "$1" ]; then
    echo -e "${YELLOW}[!] Uso: mx-dirb <URL> [wordlist]${NC}"
    echo -e "${YELLOW}[!] Ejemplo: mx-dirb http://target.com${NC}"
    exit 1
fi

WORDLIST=${2:-"/usr/share/wordlists/dirb/common.txt"}
echo -e "${GREEN}[+] Escaneando $1 con $WORDLIST${NC}"
dirb "$1" "$WORDLIST"
