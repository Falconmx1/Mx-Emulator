#!/bin/bash
# ==============================================
# Mx Update - Actualización del sistema
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx Update - Actualización           ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

echo -e "${GREEN}[+] Actualizando repositorios...${NC}"
sudo apt update

echo -e "${GREEN}[+] Actualizando paquetes...${NC}"
sudo apt upgrade -y

echo -e "${GREEN}[+] Actualizando Mx Emulator...${NC}"
if [ -d "$HOME/Mx-Emulator" ]; then
    cd "$HOME/Mx-Emulator"
    git pull
    echo -e "${GREEN}[✓] Mx Emulator actualizado${NC}"
fi

echo -e "${GREEN}[✓] Actualización completada${NC}"
