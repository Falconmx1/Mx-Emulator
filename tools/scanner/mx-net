#!/bin/bash
# ==============================================
# Mx Net Scanner - Herramientas de red
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx Net Scanner                     ║"
echo "║         Herramientas de red                 ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

# Función: Escanear hosts activos
scan-hosts() {
    echo -e "${GREEN}[+] Escaneando hosts activos en la red...${NC}"
    if command -v arp-scan &> /dev/null; then
        sudo arp-scan --local
    else
        echo -e "${YELLOW}[!] Instalando arp-scan...${NC}"
        sudo apt install -y arp-scan
        sudo arp-scan --local
    fi
}

# Función: Mostrar interfaces
show-interfaces() {
    echo -e "${CYAN}[+] Interfaces de red:${NC}"
    ip -br addr show
}

# Función: Ping sweep
ping-sweep() {
    if [ -z "$1" ]; then
        echo -e "${YELLOW}[!] Uso: mx-net ping-sweep <CIDR>${NC}"
        echo -e "${YELLOW}[!] Ejemplo: mx-net ping-sweep 192.168.1.0/24${NC}"
        return 1
    fi
    echo -e "${GREEN}[+] Haciendo ping sweep a $1...${NC}"
    nmap -sn "$1"
}

# Menú principal
case "$1" in
    hosts)
        scan-hosts
        ;;
    interfaces|iface)
        show-interfaces
        ;;
    ping-sweep|ps)
        shift
        ping-sweep "$@"
        ;;
    *)
        echo -e "${YELLOW}[!] Comandos disponibles:${NC}"
        echo "  hosts        - Escanear hosts activos"
        echo "  interfaces   - Mostrar interfaces de red"
        echo "  ping-sweep   - Ping sweep en rango"
        echo -e "${YELLOW}[!] Ejemplo: mx-net hosts${NC}"
        ;;
esac
