#!/bin/bash
# ==============================================
# Mx Pwn - Herramienta todo-en-uno
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx Pwn - Pwn Toolkit                ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

if [ -z "$1" ]; then
    echo -e "${YELLOW}[!] Modo de uso:${NC}"
    echo "  mx-pwn scan <IP>        - Escaneo completo"
    echo "  mx-pwn web <URL>        - Auditoría web"
    echo "  mx-pwn crack <hash>     - Crackear hash"
    echo "  mx-pwn wifi            - Auditoría WiFi"
    echo "  mx-pwn info <dominio>   - Recolección de info"
    echo -e "${YELLOW}[!] Ejemplo: mx-pwn scan 192.168.1.1${NC}"
    exit 1
fi

case "$1" in
    scan)
        shift
        echo -e "${CYAN}[+] Modo Escaneo: $@${NC}"
        mx-nmap "$@"
        ;;
    web)
        shift
        echo -e "${CYAN}[+] Modo Web: $@${NC}"
        mx-sqlmap "$@"
        mx-xss "$@"
        mx-dirb "$@"
        ;;
    crack)
        shift
        echo -e "${CYAN}[+] Modo Crackeo: $@${NC}"
        mx-john "$@"
        ;;
    wifi)
        echo -e "${CYAN}[+] Modo WiFi${NC}"
        mx-wifi scan
        ;;
    info)
        shift
        echo -e "${CYAN}[+] Modo Info: $@${NC}"
        mx-info "$@"
        ;;
    *)
        echo -e "${RED}[!] Modo no reconocido: $1${NC}"
        ;;
esac
