#!/bin/bash
# ==============================================
# Mx Whois - Información de dominio
# ==============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${RED}"
echo "╔══════════════════════════════════════════════╗"
echo "║         Mx Whois - Información de Dominio   ║"
echo "╚══════════════════════════════════════════════╝"
echo -e "${NC}"

if [ -z "$1" ]; then
    echo -e "${YELLOW}[!] Uso: mx-whois <dominio>${NC}"
    echo -e "${YELLOW}[!] Ejemplo: mx-whois example.com${NC}"
    exit 1
fi

echo -e "${GREEN}[+] WHOIS para $1:${NC}"
whois "$1" | grep -E "Domain|Name|Registrar|Creation|Expiration|Name Server|Status" | head -n 20
